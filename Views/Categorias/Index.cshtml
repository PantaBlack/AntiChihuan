@model IEnumerable<NoMasChihuan.Models.Categoria>
@{
    ViewData["Title"] = "Categorías";
    Layout = "_Layout";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1 tracking-tight text-white">Categorías Financieras</h2>
        <p class="text-muted small mb-0">Organización y etiquetas para tus ingresos y egresos</p>
    </div>

    <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#nuevaCategoriaModal">
        <i class="bi bi-plus-lg me-1"></i> Nueva Categoría Personalizada
    </button>
</div>

<div class="row g-4">
    <!-- Categorías de Ingresos -->
    <div class="col-md-6">
        <div class="card p-4 h-100" style="background-color: #131b2e; border: 1px solid #2a374f;">
            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2" style="border-color: #2a374f !important;">
                <div class="d-flex align-items-center gap-2">
                    <span class="stat-icon" style="background-color: rgba(16, 185, 129, 0.15); color: #34d399; width: 38px; height: 38px;">
                        <i class="bi bi-arrow-down-left fs-5"></i>
                    </span>
                    <h5 class="fw-bold text-white mb-0">Categorías de Ingreso</h5>
                </div>
                <span class="badge" style="background-color: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4);">
                    @Model.Count(c => c.Tipo == NoMasChihuan.Models.TipoTransaccion.Ingreso)
                </span>
            </div>

            <div class="list-group list-group-flush">
                @foreach (var c in Model.Where(c => c.Tipo == NoMasChihuan.Models.TipoTransaccion.Ingreso))
                {
                    <div class="list-group-item d-flex align-items-center justify-content-between px-0 py-2 border-0">
                        <div class="d-flex align-items-center gap-3">
                            <span class="stat-icon" style="background-color: @c.ColorHex; color: white; width: 38px; height: 38px; border-radius: 8px;">
                                <i class="bi @c.Icono"></i>
                            </span>
                            <div>
                                <span class="fw-semibold text-white">@c.Nombre</span>
                                @if (c.EsPredeterminada)
                                {
                                    <span class="badge border ms-1" style="background-color: #1e293b; border-color: #2a374f !important; color: #94a3b8; font-size: 0.65rem;">Predeterminada</span>
                                }
                                else
                                {
                                    <span class="badge ms-1" style="background-color: rgba(6, 182, 212, 0.15); color: #22d3ee; border: 1px solid rgba(6, 182, 212, 0.3); font-size: 0.65rem;">Personalizada</span>
                                }
                            </div>
                        </div>

                        @if (!c.EsPredeterminada)
                        {
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" onsubmit="return confirm('¿Eliminar esta categoría?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm p-1 px-2" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Categorías de Gastos -->
    <div class="col-md-6">
        <div class="card p-4 h-100" style="background-color: #131b2e; border: 1px solid #2a374f;">
            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2" style="border-color: #2a374f !important;">
                <div class="d-flex align-items-center gap-2">
                    <span class="stat-icon" style="background-color: rgba(244, 63, 94, 0.15); color: #fb7185; width: 38px; height: 38px;">
                        <i class="bi bi-arrow-up-right fs-5"></i>
                    </span>
                    <h5 class="fw-bold text-white mb-0">Categorías de Gasto</h5>
                </div>
                <span class="badge" style="background-color: rgba(244, 63, 94, 0.2); color: #fb7185; border: 1px solid rgba(244, 63, 94, 0.4);">
                    @Model.Count(c => c.Tipo == NoMasChihuan.Models.TipoTransaccion.Gasto)
                </span>
            </div>

            <div class="list-group list-group-flush">
                @foreach (var c in Model.Where(c => c.Tipo == NoMasChihuan.Models.TipoTransaccion.Gasto))
                {
                    <div class="list-group-item d-flex align-items-center justify-content-between px-0 py-2 border-0">
                        <div class="d-flex align-items-center gap-3">
                            <span class="stat-icon" style="background-color: @c.ColorHex; color: white; width: 38px; height: 38px; border-radius: 8px;">
                                <i class="bi @c.Icono"></i>
                            </span>
                            <div>
                                <span class="fw-semibold text-white">@c.Nombre</span>
                                @if (c.EsPredeterminada)
                                {
                                    <span class="badge border ms-1" style="background-color: #1e293b; border-color: #2a374f !important; color: #94a3b8; font-size: 0.65rem;">Predeterminada</span>
                                }
                                else
                                {
                                    <span class="badge ms-1" style="background-color: rgba(6, 182, 212, 0.15); color: #22d3ee; border: 1px solid rgba(6, 182, 212, 0.3); font-size: 0.65rem;">Personalizada</span>
                                }
                            </div>
                        </div>

                        @if (!c.EsPredeterminada)
                        {
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" onsubmit="return confirm('¿Eliminar esta categoría?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm p-1 px-2" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal Nueva Categoría -->
<div class="modal fade" id="nuevaCategoriaModal" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="background-color: #131b2e; border: 1px solid #2a374f;">
            <div class="modal-header border-bottom" style="border-color: #2a374f !important;">
                <h5 class="modal-title fw-bold text-white" id="modalLabel">Nueva Categoría Personalizada</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-light">Nombre de la Categoría</label>
                        <input type="text" name="Nombre" class="form-control" placeholder="Ej: Gimnasio, Mascotas, Inversiones..." required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-light">Tipo</label>
                        <select name="Tipo" class="form-select">
                            <option value="Gasto">Gasto</option>
                            <option value="Ingreso">Ingreso</option>
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-light">Color Identificador</label>
                            <input type="color" name="ColorHex" class="form-control form-control-color w-100" value="#6366f1" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-light">Icono Bootstrap</label>
                            <input type="text" name="Icono" class="form-control" value="bi-tag" placeholder="bi-tag, bi-heart..." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top" style="border-color: #2a374f !important;">
                    <button type="button" class="btn btn-outline-light btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary btn-sm">Guardar Categoría</button>
                </div>
            </form>
        </div>
    </div>
</div>
