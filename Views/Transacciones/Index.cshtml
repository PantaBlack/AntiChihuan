@model NoMasChihuan.Models.ViewModels.TransaccionListViewModel
@{
    ViewData["Title"] = "Transacciones";
    Layout = "_Layout";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1 tracking-tight text-white">Historial de Transacciones</h2>
        <p class="text-muted small mb-0">Gestiona, filtra y analiza tus ingresos y egresos financieros</p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-action="ExportarCsv" class="btn btn-outline-light btn-sm rounded-pill px-3">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Exportar CSV
        </a>
        <a asp-action="Create" asp-route-tipo="Gasto" class="btn btn-danger btn-sm rounded-pill px-3 shadow-sm">
            <i class="bi bi-dash-circle me-1"></i> Registrar Gasto
        </a>
        <a asp-action="Create" asp-route-tipo="Ingreso" class="btn btn-success btn-sm rounded-pill px-3 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Registrar Ingreso
        </a>
    </div>
</div>

<!-- Barra de Filtros -->
<div class="card p-3 mb-4" style="background-color: #131b2e; border: 1px solid #2a374f;">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-2 col-6">
            <label class="form-label small fw-semibold text-light mb-1">Mes</label>
            <select name="mes" class="form-select form-select-sm">
                <option value="">Todos los meses</option>
                @for (int m = 1; m <= 12; m++)
                {
                    var mName = new System.Globalization.CultureInfo("es-PE").DateTimeFormat.GetMonthName(m);
                    mName = char.ToUpper(mName[0]) + mName[1..];
                    <option value="@m" selected="@(Model.Mes == m)">@mName</option>
                }
            </select>
        </div>

        <div class="col-md-2 col-6">
            <label class="form-label small fw-semibold text-light mb-1">Año</label>
            <select name="anio" class="form-select form-select-sm">
                <option value="">Todos los años</option>
                @for (int a = DateTime.Today.Year - 2; a <= DateTime.Today.Year + 1; a++)
                {
                    <option value="@a" selected="@(Model.Anio == a)">@a</option>
                }
            </select>
        </div>

        <div class="col-md-2 col-6">
            <label class="form-label small fw-semibold text-light mb-1">Tipo</label>
            <select name="tipo" class="form-select form-select-sm">
                <option value="">Todos los tipos</option>
                <option value="Ingreso" selected="@(Model.Tipo == NoMasChihuan.Models.TipoTransaccion.Ingreso)">Ingreso</option>
                <option value="Gasto" selected="@(Model.Tipo == NoMasChihuan.Models.TipoTransaccion.Gasto)">Gasto</option>
            </select>
        </div>

        <div class="col-md-3 col-6">
            <label class="form-label small fw-semibold text-light mb-1">Categoría</label>
            <select name="categoriaId" asp-items="Model.CategoriasSelectList" class="form-select form-select-sm">
                <option value="">Todas las categorías</option>
            </select>
        </div>

        <div class="col-md-2 col-6">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" name="soloHormiga" value="true" id="checkHormiga" checked="@(Model.SoloHormiga == true)" />
                <label class="form-check-label small fw-bold text-warning" for="checkHormiga">
                    Solo Hormiga 🐜
                </label>
            </div>
        </div>

        <div class="col-md-1 col-6">
            <button type="submit" class="btn btn-primary btn-sm w-100">
                <i class="bi bi-funnel"></i>
            </button>
        </div>
    </form>
</div>

<!-- Métricas Filtradas -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-3" style="background-color: #131b2e; border: 1px solid #2a374f;">
            <small class="text-muted fw-semibold">Ingresos Filtrados</small>
            <h4 class="fw-bold mb-0" style="color: #34d399;">+ S/ @Model.TotalIngresosFiltrados.ToString("N2")</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3" style="background-color: #131b2e; border: 1px solid #2a374f;">
            <small class="text-muted fw-semibold">Gastos Filtrados</small>
            <h4 class="fw-bold mb-0" style="color: #fb7185;">- S/ @Model.TotalGastosFiltrados.ToString("N2")</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3" style="background-color: #131b2e; border: 1px solid #2a374f;">
            <small class="text-muted fw-semibold">Balance Resultado</small>
            <h4 class="fw-bold mb-0 @(Model.BalanceFiltrado >= 0 ? "text-white" : "text-danger")">
                S/ @Model.BalanceFiltrado.ToString("N2")
            </h4>
        </div>
    </div>
</div>

<!-- Tabla de Resultados -->
<div class="card" style="background-color: #131b2e; border: 1px solid #2a374f;">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Categoría</th>
                    <th>Descripción</th>
                    <th class="text-end">Monto</th>
                    <th class="text-center" style="width: 120px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Transacciones.Any())
                {
                    @foreach (var item in Model.Transacciones)
                    {
                        <tr>
                            <td class="small text-muted">@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.Tipo == NoMasChihuan.Models.TipoTransaccion.Ingreso)
                                {
                                    <span class="badge" style="background-color: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3);">Ingreso</span>
                                }
                                else
                                {
                                    <span class="badge" style="background-color: rgba(244, 63, 94, 0.15); color: #fb7185; border: 1px solid rgba(244, 63, 94, 0.3);">Gasto</span>
                                }
                            </td>
                            <td>
                                <span class="badge border" style="background-color: #1e293b; border-color: #2a374f !important; color: #e2e8f0;">
                                    <i class="bi @item.Categoria?.Icono me-1"></i> @item.Categoria?.Nombre
                                </span>
                            </td>
                            <td>
                                <div class="fw-medium text-white">@item.Descripcion</div>
                                @if (item.EsGastoHormiga)
                                {
                                    <span class="badge" style="background-color: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4); font-size: 0.65rem;">Gasto Hormiga 🐜</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Notas))
                                {
                                    <div class="small" style="font-size: 0.75rem; color: #94a3b8;">@item.Notas</div>
                                }
                            </td>
                            <td class="text-end fw-bold @(item.Tipo == NoMasChihuan.Models.TipoTransaccion.Ingreso ? "text-success" : "text-danger")">
                                @(item.Tipo == NoMasChihuan.Models.TipoTransaccion.Ingreso ? "+" : "-") S/ @item.Monto.ToString("N2")
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-light" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('¿Seguro que deseas eliminar este registro?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                            No se encontraron transacciones con los filtros seleccionados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
