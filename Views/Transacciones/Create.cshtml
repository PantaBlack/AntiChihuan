@model NoMasChihuan.Models.ViewModels.TransaccionFormViewModel
@{
    ViewData["Title"] = "Nueva Transacción";
    Layout = "_Layout";
}

<div class="container-fluid py-2">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card p-4 shadow-sm" style="background-color: #131b2e; border: 1px solid #2a374f;">
                <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-3" style="border-color: #2a374f !important;">
                    <div>
                        <h4 class="fw-bold text-white mb-1">Registrar Movimiento</h4>
                        <p class="text-muted small mb-0">Añade un nuevo ingreso o gasto a tu control financiero</p>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-arrow-left"></i> Volver
                    </a>
                </div>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" style="background-color: #881337; border-color: #e11d48; color: #fecdd3;"></div>

                    <!-- Selector de Tipo: Ingreso / Gasto -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-light">Tipo de Transacción</label>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="Tipo" id="tipoGasto" value="Gasto" 
                                   checked="@(Model.Tipo == NoMasChihuan.Models.TipoTransaccion.Gasto)" onchange="cambiarTipo('Gasto')">
                            <label class="btn btn-outline-danger py-2 fw-semibold" for="tipoGasto">
                                <i class="bi bi-dash-circle me-1"></i> Gasto
                            </label>

                            <input type="radio" class="btn-check" name="Tipo" id="tipoIngreso" value="Ingreso" 
                                   checked="@(Model.Tipo == NoMasChihuan.Models.TipoTransaccion.Ingreso)" onchange="cambiarTipo('Ingreso')">
                            <label class="btn btn-outline-success py-2 fw-semibold" for="tipoIngreso">
                                <i class="bi bi-plus-circle me-1"></i> Ingreso
                            </label>
                        </div>
                    </div>

                    <!-- Monto y Fecha -->
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Monto" class="form-label small fw-semibold text-light">Monto (S/)</label>
                            <div class="input-group">
                                <span class="input-group-text fw-bold">S/</span>
                                <input asp-for="Monto" type="number" step="0.01" class="form-control form-control-lg fw-bold" placeholder="0.00" autofocus />
                            </div>
                            <span asp-validation-for="Monto" class="text-danger small"></span>
                        </div>

                        <div class="col-sm-6">
                            <label asp-for="Fecha" class="form-label small fw-semibold text-light">Fecha</label>
                            <input asp-for="Fecha" type="date" class="form-control form-control-lg" />
                            <span asp-validation-for="Fecha" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Descripción -->
                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label small fw-semibold text-light">Descripción o Concepto</label>
                        <input asp-for="Descripcion" class="form-control" placeholder="Ej: Compra de despensa, Café, Sueldo quincena..." />
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <!-- Categoría -->
                    <div class="mb-3">
                        <label asp-for="CategoriaId" class="form-label small fw-semibold text-light">Categoría</label>
                        <select asp-for="CategoriaId" asp-items="Model.CategoriasSelectList" class="form-select" id="categoriaSelect">
                            <option value="">-- Selecciona una categoría --</option>
                        </select>
                        <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                    </div>

                    <!-- Toggle Gasto Hormiga -->
                    <div class="mb-3 p-3 rounded-3" id="hormigaSection" style="background-color: #1a233a; border: 1px solid #2a374f;">
                        <div class="form-check form-switch mb-0">
                            <input asp-for="EsGastoHormiga" class="form-check-input" type="checkbox" id="checkHormigaInput" />
                            <label class="form-check-label fw-bold small text-warning" for="checkHormigaInput">
                                Marcar como "Gasto Hormiga" 🐜
                            </label>
                        </div>
                        <small class="d-block mt-1" style="font-size: 0.78rem; color: #94a3b8;">
                            Actívalo para pequeños gastos no esenciales (snacks, gaseosas, propinas, taxis no planificados) que drenan tu dinero.
                        </small>
                    </div>

                    <!-- Notas adicionales -->
                    <div class="mb-4">
                        <label asp-for="Notas" class="form-label small fw-semibold text-light">Notas o Lugar (Opcional)</label>
                        <textarea asp-for="Notas" class="form-control" rows="2" placeholder="Detalles adicionales..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm">
                        <i class="bi bi-save me-1"></i> Guardar Movimiento
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function cambiarTipo(tipo) {
            const hormigaSec = document.getElementById('hormigaSection');
            if (tipo === 'Ingreso') {
                hormigaSec.style.display = 'none';
            } else {
                hormigaSec.style.display = 'block';
            }

            fetch(`/Transacciones/GetCategoriasPorTipo?tipo=${tipo}`)
                .then(res => res.json())
                .then(data => {
                    const select = document.getElementById('categoriaSelect');
                    select.innerHTML = '<option value="">-- Selecciona una categoría --</option>';
                    data.forEach(item => {
                        const opt = document.createElement('option');
                        opt.value = item.id;
                        opt.textContent = item.nombre;
                        select.appendChild(opt);
                    });
                });
        }
    </script>
}
