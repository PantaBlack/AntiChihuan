@model NoMasChihuan.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="row g-4 justify-content-center align-items-start">
        
        <!-- Formulario de Inicio de Sesión -->
        <div class="col-lg-5">
            <div class="card p-4 p-md-5 shadow-lg" style="background-color: #131b2e; border: 1px solid #2a374f;">
                <div class="text-center mb-4">
                    <span class="stat-icon mx-auto mb-3" style="background: linear-gradient(135deg, #4f46e5, #06b6d4); color: white; width: 56px; height: 56px; border-radius: 14px;">
                        <i class="bi bi-shield-lock-fill fs-3"></i>
                    </span>
                    <h3 class="fw-bold text-white mb-1">Acceso AntiChihuan</h3>
                    <p class="small text-muted mb-0">Control financiero y análisis inteligente de gastos</p>
                </div>

                <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" id="loginForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert" style="background-color: #881337; border-color: #e11d48; color: #fecdd3;"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold small text-light"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" id="inputEmail" placeholder="ejemplo@correo.com" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold small text-light"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" class="form-control" id="inputPassword" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small text-light"></label>
                    </div>

                    <button type="submit" class="btn btn-warning w-100 py-2 mb-3 fw-bold text-dark shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                    </button>

                    <div class="text-center small text-muted">
                        ¿No tienes una cuenta aún? <a asp-action="Register" class="text-warning fw-semibold text-decoration-none">Regístrate aquí</a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Panel de 10 Cuentas de Prueba Preconfiguradas -->
        <div class="col-lg-7">
            <div class="card p-4 shadow-lg" style="background-color: #131b2e; border: 1px solid #2a374f;">
                <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-3" style="border-color: #2a374f !important;">
                    <div>
                        <span class="badge bg-warning text-dark fw-bold mb-1"><i class="bi bi-people-fill me-1"></i> 10 Perfiles Preconfigurados</span>
                        <h5 class="fw-bold text-white mb-0">Selecciona una Cuenta para Probar</h5>
                    </div>
                    <small class="text-muted d-none d-sm-block">Contraseña común: <code>Password123!</code></small>
                </div>

                <p class="small text-muted mb-3">
                    Haz clic en <span class="badge bg-primary text-white">Usar cuenta</span> para rellenar automáticamente las credenciales y probar cada caso de uso:
                </p>

                <!-- Nav Tabs -->
                <ul class="nav nav-pills mb-3 gap-2" id="demoTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active btn-sm rounded-pill px-3" id="equipo-tab" data-bs-toggle="pill" data-bs-target="#tab-equipo" type="button" role="tab" style="background-color: #1e293b; color: #f8fafc;">
                            👥 Equipo AntiChihuan (5)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link btn-sm rounded-pill px-3" id="extremos-tab" data-bs-toggle="pill" data-bs-target="#tab-extremos" type="button" role="tab" style="background-color: #1e293b; color: #f8fafc;">
                            🔥 Perfiles Extremos (5)
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="demoTabsContent">
                    
                    <!-- TAB 1: LOS 5 INTEGRANTES DEL EQUIPO -->
                    <div class="tab-pane fade show active" id="tab-equipo" role="tabpanel">
                        <div class="d-flex flex-column gap-2" style="max-height: 480px; overflow-y: auto;">
                            
                            <!-- Gianino -->
                            <div class="p-3 rounded-3 d-flex align-items-center justify-content-between" style="background-color: #172033; border: 1px solid #2a374f;">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <strong class="text-white">Gianino Naranjo</strong>
                                        <span class="badge bg-success-subtle text-success border border-success" style="font-size: 0.65rem;">S/ 5,000 | Ahorro S/ 2,550</span>
                                    </div>
                                    <small class="text-muted d-block">Rol: BD y Finanzas • Finanzas Saludables y Ahorro</small>
                                    <code class="small text-light opacity-75">gianino@antichihuan.pe</code>
                                </div>
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="cargarDemo('gianino@antichihuan.pe')">
                                    Usar <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>

                            <!-- Alexis -->
                            <div class="p-3 rounded-3 d-flex align-items-center justify-content-between" style="background-color: #172033; border: 1px solid #2a374f;">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <strong class="text-white">Alexis Huerta</strong>
                                        <span class="badge bg-info-subtle text-info border border-info" style="font-size: 0.65rem;">S/ 16,500 | Mucho Dinero 💎</span>
                                    </div>
                                    <small class="text-muted d-block">Rol: IA • Tech Lead con Alto Patrimonio y Dividendos</small>
                                    <code class="small text-light opacity-75">alexis@antichihuan.pe</code>
                                </div>
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="cargarDemo('alexis@antichihuan.pe')">
                                    Usar <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>

                            <!-- Anderson -->
                            <div class="p-3 rounded-3 d-flex align-items-center justify-content-between" style="background-color: #172033; border: 1px solid #2a374f;">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <strong class="text-white">Anderson Larios</strong>
                                        <span class="badge bg-danger-subtle text-danger border border-danger" style="font-size: 0.65rem;">Deudas Críticas S/ -1,520 🚨</span>
                                    </div>
                                    <small class="text-muted d-block">Rol: Backend • Tarjetas reventadas & Préstamos (Modo Chihuán)</small>
                                    <code class="small text-light opacity-75">anderson@antichihuan.pe</code>
                                </div>
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="cargarDemo('anderson@antichihuan.pe')">
                                    Usar <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>

                            <!-- Samir -->
