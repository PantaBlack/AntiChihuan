                                    </div>
                                    <small class="text-muted d-block">Rol: Estadísticas • Sueldo gastado en Starbucks, Deliveries y Taxis</small>
                                    <code class="small text-light opacity-75">samir@antichihuan.pe</code>
                                </div>
                                <button type="button" class="btn btn-outline-warning btn-sm rounded-pill px-3" onclick="cargarDemo('samir@antichihuan.pe')">
                                    Usar <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>

                            <!-- Yimmy -->
                            <div class="p-3 rounded-3 d-flex align-items-center justify-content-between" style="background-color: #172033; border: 1px solid #2a374f;">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <strong class="text-white">Yimmy Diaz</strong>
                                        <span class="badge bg-success-subtle text-success border border-success" style="font-size: 0.65rem;">S/ 3,600 | Presupuesto Óptimo 🎯</span>
                                    </div>
                                    <small class="text-muted d-block">Rol: Frontend • Control estricto de presupuesto por categoría</small>
                                    <code class="small text-light opacity-75">yimmy@antichihuan.pe</code>
                                </div>
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="cargarDemo('yimmy@antichihuan.pe')">
                                    Usar <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>

                        </div>
                    </div>

                    <!-- TAB 2: PERFILES FINANCIEROS EXTREMOS -->
                    <div class="tab-pane fade" id="tab-extremos" role="tabpanel">
                        <div class="d-flex flex-column gap-2" style="max-height: 480px; overflow-y: auto;">
                            
                            <!-- Carlos Slim -->
                            <div class="p-3 rounded-3 d-flex align-items-center justify-content-between" style="background-color: #172033; border: 1px solid #2a374f;">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <strong class="text-white">Carlos Slim Rodríguez</strong>
                                        <span class="badge bg-info-subtle text-info border border-info" style="font-size: 0.65rem;">Ingresos S/ 38,000 / mes 💰</span>
                                    </div>
                                    <small class="text-muted d-block">Empresario / Mucho Dinero • Superávit de S/ 28,800</small>
                                    <code class="small text-light opacity-75">carlos.slim@antichihuan.pe</code>
                                </div>
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="cargarDemo('carlos.slim@antichihuan.pe')">
                                    Usar <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>

                            <!-- Valeria Mendoza -->
                            <div class="p-3 rounded-3 d-flex align-items-center justify-content-between" style="background-color: #172033; border: 1px solid #2a374f;">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <strong class="text-white">Valeria Mendoza Paz</strong>
                                        <span class="badge bg-danger-subtle text-danger border border-danger" style="font-size: 0.65rem;">Quiebra S/ -2,750 ⚠️</span>
                                    </div>
                                    <small class="text-muted d-block">Muchas Deudas • Préstamos atrasados e intereses moratorios</small>
                                    <code class="small text-light opacity-75">valeria.deudas@antichihuan.pe</code>
                                </div>
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="cargarDemo('valeria.deudas@antichihuan.pe')">
                                    Usar <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>

                            <!-- Mateo Quispe -->
                            <div class="p-3 rounded-3 d-flex align-items-center justify-content-between" style="background-color: #172033; border: 1px solid #2a374f;">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <strong class="text-white">Mateo Quispe Flores</strong>
                                        <span class="badge bg-warning-subtle text-warning border border-warning" style="font-size: 0.65rem;">51.8% en Comida Rápida 🍔</span>
                                    </div>
                                    <small class="text-muted d-block">Adicto al Delivery • Rappi, PedidosYa y compras compulsivas</small>
                                    <code class="small text-light opacity-75">mateo.delivery@antichihuan.pe</code>
                                </div>
                                <button type="button" class="btn btn-outline-warning btn-sm rounded-pill px-3" onclick="cargarDemo('mateo.delivery@antichihuan.pe')">
                                    Usar <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>

                            <!-- Lucía Fernández -->
                            <div class="p-3 rounded-3 d-flex align-items-center justify-content-between" style="background-color: #172033; border: 1px solid #2a374f;">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <strong class="text-white">Lucía Fernández Castro</strong>
                                        <span class="badge bg-success-subtle text-success border border-success" style="font-size: 0.65rem;">Ahorro Frugal 64% 🌿</span>
                                    </div>
                                    <small class="text-muted d-block">Minimalista • Ingreso S/ 4,500 y gasta solo S/ 1,600</small>
                                    <code class="small text-light opacity-75">lucia.frugal@antichihuan.pe</code>
                                </div>
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="cargarDemo('lucia.frugal@antichihuan.pe')">
                                    Usar <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>

                            <!-- Renzo Balbuena -->
                            <div class="p-3 rounded-3 d-flex align-items-center justify-content-between" style="background-color: #172033; border: 1px solid #2a374f;">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <strong class="text-white">Renzo Balbuena Silva</strong>
                                        <span class="badge bg-danger-subtle text-danger border border-danger" style="font-size: 0.65rem;">Presupuesto +202% 🛑</span>
                                    </div>
                                    <small class="text-muted d-block">Súper Chihuán • Zapatillas en cuotas, apuestas y farras</small>
                                    <code class="small text-light opacity-75">renzo.chihuan@antichihuan.pe</code>
                                </div>
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="cargarDemo('renzo.chihuan@antichihuan.pe')">
                                    Usar <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function cargarDemo(email) {
            document.getElementById('inputEmail').value = email;
            document.getElementById('inputPassword').value = 'Password123!';
            // Animar el formulario para mostrar que se cargó
            const formCard = document.getElementById('loginForm');
            formCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
            document.getElementById('inputEmail').focus();
        }
    </script>
}
