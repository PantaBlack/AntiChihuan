@model NoMasChihuan.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Crear Cuenta";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card p-4 p-md-5 shadow-lg" style="background-color: #131b2e; border: 1px solid #2a374f;">
                <div class="text-center mb-4">
                    <span class="stat-icon mx-auto mb-3" style="background: linear-gradient(135deg, #f59e0b, #ef4444); color: white; width: 56px; height: 56px; border-radius: 14px;">
                        <i class="bi bi-person-plus-fill fs-3"></i>
                    </span>
                    <h3 class="fw-bold text-white mb-1">Únete a AntiChihuan</h3>
                    <p class="small text-muted mb-0">Comienza a administrar tus ingresos y erradicar gastos hormiga</p>
                </div>

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert" style="background-color: #881337; border-color: #e11d48; color: #fecdd3;"></div>

                    <div class="mb-3">
                        <label asp-for="NombreCompleto" class="form-label fw-semibold small text-light"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="NombreCompleto" class="form-control" placeholder="Gianino Naranjo" autofocus />
                        </div>
                        <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold small text-light"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="nombre@correo.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold small text-light"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="Mínimo 6 caracteres" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold small text-light"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Repite tu contraseña" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-warning text-dark fw-bold w-100 py-2 mb-3 shadow-sm">
                        <i class="bi bi-check-lg me-1"></i> Registrarse Ahora
                    </button>

                    <div class="text-center small text-muted">
                        ¿Ya tienes cuenta? <a asp-action="Login" class="text-warning fw-semibold text-decoration-none">Inicia sesión</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
