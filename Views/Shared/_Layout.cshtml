<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AntiChihuan</title>
    
    <!-- Favicon Oficial AntiChihuan -->
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="shortcut icon" href="~/favicon.svg" />
    
    <!-- Bootstrap 5 CSS Dark Mode -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom Dark Fintech CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: #0b0f19; color: #f8fafc;">

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- App Wrapper with Sidebar -->
        <div class="d-flex" id="wrapper">
            <!-- Sidebar -->
            <div class="border-end shadow-sm" id="sidebar-wrapper" 
                 style="min-width: 260px; min-height: 100vh; background-color: #090d16; border-color: #1e293b !important;">
                
                <div class="sidebar-heading px-4 py-4 border-bottom d-flex align-items-center justify-content-between" style="border-color: #1e293b !important;">
                    <a asp-controller="Dashboard" asp-action="Index" class="text-white text-decoration-none d-flex align-items-center gap-2">
                        <span class="badge p-2 rounded-3" style="background: linear-gradient(135deg, #4f46e5, #06b6d4);">
                            <i class="bi bi-shield-check fs-5 text-white"></i>
                        </span>
                        <div>
                            <span class="fs-5 fw-bold tracking-tight text-white">Anti<span class="text-warning">Chihuan</span></span>
                            <div class="text-muted small" style="font-size: 0.72rem;">Finanzas con IA</div>
                        </div>
                    </a>
                </div>

                <div class="list-group list-group-flush my-3 px-3 gap-1">
                    <a asp-controller="Dashboard" asp-action="Index" 
                       class="list-group-item list-group-item-action rounded-3 d-flex align-items-center gap-3 py-2 text-light border-0 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "bg-primary text-white fw-bold shadow-sm" : "hover-dark")">
                        <i class="bi bi-grid-1x2-fill text-info"></i> Dashboard
                    </a>
                    <a asp-controller="Transacciones" asp-action="Index" 
                       class="list-group-item list-group-item-action rounded-3 d-flex align-items-center gap-3 py-2 text-light border-0 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Transacciones" ? "bg-primary text-white fw-bold shadow-sm" : "hover-dark")">
                        <i class="bi bi-arrow-left-right text-success"></i> Transacciones
                    </a>
                    <a asp-controller="Presupuestos" asp-action="Index" 
                       class="list-group-item list-group-item-action rounded-3 d-flex align-items-center gap-3 py-2 text-light border-0 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Presupuestos" ? "bg-primary text-white fw-bold shadow-sm" : "hover-dark")">
                        <i class="bi bi-pie-chart-fill text-warning"></i> Presupuestos
                    </a>
                    <a asp-controller="Categorias" asp-action="Index" 
                       class="list-group-item list-group-item-action rounded-3 d-flex align-items-center gap-3 py-2 text-light border-0 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Categorias" ? "bg-primary text-white fw-bold shadow-sm" : "hover-dark")">
                        <i class="bi bi-tags-fill text-primary"></i> Categorías
                    </a>
                    <a asp-controller="IA" asp-action="Index" 
                       class="list-group-item list-group-item-action rounded-3 d-flex align-items-center gap-3 py-2 text-light border-0 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "IA" ? "bg-primary text-white fw-bold shadow-sm" : "hover-dark")">
                        <i class="bi bi-robot text-warning"></i> Asistente IA
                        <span class="badge bg-warning text-dark ms-auto fw-bold" style="font-size: 0.65rem;">Gemini</span>
                    </a>
                </div>

                <div class="px-4 mt-auto pt-4 pb-3 border-top small" style="border-color: #1e293b !important; color: #94a3b8;">
                    <p class="mb-1 text-light fw-semibold"><i class="bi bi-people-fill text-primary me-1"></i> Equipo AntiChihuan</p>
                    <div style="font-size: 0.72rem; line-height: 1.5; color: #94a3b8;">
                        • Alexis H. (IA)<br>
                        • Anderson L. (Backend)<br>
                        • Gianino N. (BD y Finanzas)<br>
                        • Samir R. (Estadísticas)<br>
                        • Yimmy D. (Frontend)
                    </div>
                </div>
            </div>

            <!-- Page Content Wrapper -->
            <div id="page-content-wrapper" class="w-100 d-flex flex-column" style="background-color: #0b0f19;">
                <!-- Top Navigation -->
                <nav class="navbar navbar-expand-lg border-bottom px-4 py-3 sticky-top" 
                     style="background-color: #131b2e; border-color: #1e293b !important;">
                    <div class="container-fluid p-0">
                        <button class="btn btn-outline-secondary btn-sm d-md-none me-2" id="sidebarToggle">
                            <i class="bi bi-list"></i>
                        </button>
                        
                        <div class="d-none d-sm-block">
                            <span class="text-muted small">Panel de Control Financiero</span>
                            <h6 class="mb-0 fw-bold text-white">@User.Identity?.Name</h6>
                        </div>

                        <div class="ms-auto d-flex align-items-center gap-2">
                            <a asp-controller="Transacciones" asp-action="Create" asp-route-tipo="Gasto" class="btn btn-danger btn-sm rounded-pill px-3 shadow-sm">
                                <i class="bi bi-dash-circle me-1"></i> - Gasto
                            </a>
                            <a asp-controller="Transacciones" asp-action="Create" asp-route-tipo="Ingreso" class="btn btn-success btn-sm rounded-pill px-3 shadow-sm">
                                <i class="bi bi-plus-circle me-1"></i> + Ingreso
                            </a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill ms-2" title="Cerrar Sesión">
                                    <i class="bi bi-box-arrow-right"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </nav>

                <!-- Main Content Area -->
                <div class="container-fluid p-4">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert" style="background-color: #064e3b; border-color: #059669; color: #a7f3d0;">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert" style="background-color: #881337; border-color: #e11d48; color: #fecdd3;">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </div>

                <!-- Footer -->
                <footer class="footer mt-auto py-3 border-top text-center small" style="background-color: #090d16; border-color: #1e293b !important; color: #64748b;">
                    <div class="container">
                        &copy; 2026 <strong class="text-light">AntiChihuan</strong> - Sistema Web Inteligente de Control de Gastos Personales con IA.
                    </div>
                </footer>
            </div>
        </div>
    }
    else
    {
        <!-- Public Navigation (Landing & Auth) -->
        <header>
            <nav class="navbar navbar-expand-lg py-3 sticky-top" style="background-color: #090d16; border-bottom: 1px solid #1e293b;">
                <div class="container">
                    <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                        <span class="badge p-2 rounded-3" style="background: linear-gradient(135deg, #4f46e5, #06b6d4);">
                            <i class="bi bi-shield-check fs-5 text-white"></i>
                        </span>
                        <span class="fs-4 text-white">Anti<span class="text-warning">Chihuan</span></span>
                    </a>
                    <button class="navbar-toggler btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#navPublic">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navPublic">
                        <ul class="navbar-nav ms-auto align-items-center gap-3">
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Home" asp-action="Index">Inicio</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm px-4 rounded-pill" asp-controller="Account" asp-action="Login">Iniciar Sesión</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-warning btn-sm px-4 rounded-pill fw-bold text-dark shadow-sm" asp-controller="Account" asp-action="Register">Registrarse</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <main role="main">
            @RenderBody()
        </main>

        <footer class="footer py-4 border-top text-center small" style="background-color: #090d16; border-color: #1e293b !important; color: #64748b;">
            <div class="container">
                <p class="mb-1 text-light fw-bold">AntiChihuan &copy; 2026 - Universidad / Proyecto Integrador</p>
                <p class="text-muted mb-0">Desarrollado con ASP.NET Core MVC 10, Entity Framework Core y Google Gemini AI.</p>
            </div>
        </footer>
    }

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const sidebarToggle = document.getElementById('sidebarToggle');
        if (sidebarToggle) {
            sidebarToggle.addEventListener('click', () => {
                document.getElementById('sidebar-wrapper').classList.toggle('d-none');
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
